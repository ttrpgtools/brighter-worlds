{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Same compatible application, with cloud operations unavailable. Preserve
  // the active dev Custom Domain here before any authorized recovery deployment.
  "name": "brighter-worlds-dev",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-06-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
    "run_worker_first": true,
  },
  "services": [],
  "vars": { "PUBLIC_ANKH": "https://ankh.ttrpg.tools" },
}
