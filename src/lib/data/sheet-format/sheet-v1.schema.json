{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brighterworlds.app/schemas/sheet-v1.schema.json",
  "title": "Brighter Worlds sheet v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "brighter-worlds.sheet"
    },
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "createdAt": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "pronouns": {
          "type": "string",
          "maxLength": 512
        },
        "grit": {
          "$ref": "#/$defs/attribute"
        },
        "str": {
          "$ref": "#/$defs/dieAttribute"
        },
        "dex": {
          "$ref": "#/$defs/dieAttribute"
        },
        "wil": {
          "$ref": "#/$defs/dieAttribute"
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "equipment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 1000
        },
        "calling": {
          "$ref": "#/$defs/entity"
        },
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ability"
          },
          "maxItems": 1000
        },
        "eulogy": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "message": {
                "type": "string",
                "maxLength": 65536
              },
              "xp": {
                "type": "boolean"
              },
              "spent": {
                "type": "boolean"
              }
            },
            "required": ["id", "message", "xp", "spent"]
          },
          "maxItems": 1000
        },
        "spells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spell"
          },
          "maxItems": 1000
        },
        "rituals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ritual"
          },
          "maxItems": 1000
        },
        "notes": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [
        "name",
        "pronouns",
        "grit",
        "str",
        "dex",
        "wil",
        "statuses",
        "equipment",
        "calling",
        "abilities",
        "eulogy",
        "spells",
        "rituals",
        "notes"
      ]
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "companion"
          },
          "abilityId": {
            "$ref": "#/$defs/id"
          },
          "sheetId": {
            "$ref": "#/$defs/id"
          }
        },
        "required": ["kind", "abilityId", "sheetId"]
      },
      "maxItems": 1000,
      "uniqueItems": true
    }
  },
  "required": ["format", "version", "id", "createdAt", "character", "relations"],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["current", "max"]
    },
    "dieAttribute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current": {
          "enum": [0, 4, 6, 8, 10, 12]
        },
        "max": {
          "enum": [4, 6, 8, 10, 12]
        }
      },
      "required": ["current", "max"]
    },
    "image": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "url"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^https?://[^\\s/@?#]+(?:[/?#][^\\s]*)?$",
              "format": "uri"
            }
          },
          "required": ["kind", "url"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "bundle-asset"
            },
            "assetId": {
              "$ref": "#/$defs/id"
            }
          },
          "required": ["kind", "assetId"]
        }
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "desc": {
          "type": "string",
          "maxLength": 65536
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "icon": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": ["id", "name"]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "desc": {
          "type": "string",
          "maxLength": 65536
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "icon": {
          "type": "string",
          "maxLength": 128
        },
        "damage": {
          "oneOf": [
            {
              "enum": [4, 6, 8, 10, 12]
            },
            {
              "type": "array",
              "items": {
                "enum": [4, 6, 8, 10, 12]
              },
              "maxItems": 32,
              "minItems": 1
            }
          ]
        },
        "blast": {
          "type": "boolean"
        },
        "legacyRules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extra": {
              "enum": [4, 6, 8, 10, 12]
            },
            "enableMagic": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "enum": ["spell", "ritual", "spells", "rituals", "all"]
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["type"]
                }
              ]
            }
          },
          "required": []
        },
        "unequiped": {
          "type": "boolean"
        },
        "bulky": {
          "type": "boolean"
        },
        "depleted": {
          "type": "boolean"
        },
        "armor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fragile": {
          "type": "boolean"
        },
        "quantity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quantFormula": {
          "type": "string",
          "maxLength": 512
        },
        "magic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "charges": {
              "$ref": "#/$defs/attribute"
            },
            "spell": {
              "oneOf": [
                {
                  "$ref": "#/$defs/spell"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/spell"
                  },
                  "maxItems": 1000
                }
              ]
            },
            "ritual": {
              "oneOf": [
                {
                  "$ref": "#/$defs/ritual"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ritual"
                  },
                  "maxItems": 1000
                }
              ]
            }
          },
          "required": []
        }
      },
      "required": ["id", "name"]
    },
    "ability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "desc": {
          "type": "string",
          "maxLength": 65536
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "icon": {
          "type": "string",
          "maxLength": 128
        },
        "damage": {
          "oneOf": [
            {
              "enum": [4, 6, 8, 10, 12]
            },
            {
              "type": "array",
              "items": {
                "enum": [4, 6, 8, 10, 12]
              },
              "maxItems": 32,
              "minItems": 1
            }
          ]
        },
        "blast": {
          "type": "boolean"
        },
        "legacyRules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extra": {
              "enum": [4, 6, 8, 10, 12]
            }
          },
          "required": []
        },
        "type": {
          "enum": ["core", "advanced", "companion", "enhance"]
        },
        "details": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": ["id", "name", "type"]
    },
    "spell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "desc": {
          "type": "string",
          "maxLength": 65536
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "icon": {
          "type": "string",
          "maxLength": 128
        },
        "damage": {
          "oneOf": [
            {
              "enum": [4, 6, 8, 10, 12]
            },
            {
              "type": "array",
              "items": {
                "enum": [4, 6, 8, 10, 12]
              },
              "maxItems": 32,
              "minItems": 1
            }
          ]
        },
        "blast": {
          "type": "boolean"
        },
        "legacyRules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extra": {
              "enum": [4, 6, 8, 10, 12]
            }
          },
          "required": []
        },
        "type": {
          "const": "spell"
        }
      },
      "required": ["id", "name", "type"]
    },
    "ritual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "desc": {
          "type": "string",
          "maxLength": 65536
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "icon": {
          "type": "string",
          "maxLength": 128
        },
        "damage": {
          "oneOf": [
            {
              "enum": [4, 6, 8, 10, 12]
            },
            {
              "type": "array",
              "items": {
                "enum": [4, 6, 8, 10, 12]
              },
              "maxItems": 32,
              "minItems": 1
            }
          ]
        },
        "blast": {
          "type": "boolean"
        },
        "legacyRules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extra": {
              "enum": [4, 6, 8, 10, 12]
            }
          },
          "required": []
        },
        "type": {
          "const": "ritual"
        }
      },
      "required": ["id", "name", "type"]
    }
  }
}
