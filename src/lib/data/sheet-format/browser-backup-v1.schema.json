{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brighterworlds.app/schemas/browser-backup-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "brighter-worlds.browser-backup"
    },
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/id"
    },
    "exportedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "characters": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://brighterworlds.app/schemas/bundle-v1.schema.json"
        }
      ]
    },
    "gameData": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "const": "bw-encounters"
              },
              "value": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "$ref": "#/$defs/encounter"
                }
              }
            },
            "required": ["key", "value"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "const": "bw-playmat"
              },
              "value": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/id"
                        },
                        "type": {
                          "const": "npc"
                        },
                        "npc": {
                          "$ref": "#/$defs/instance"
                        }
                      },
                      "required": ["id", "type", "npc"]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/id"
                        },
                        "type": {
                          "const": "scene"
                        },
                        "scene": {
                          "$ref": "#/$defs/scene"
                        }
                      },
                      "required": ["id", "type", "scene"]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/id"
                        },
                        "type": {
                          "const": "item"
                        },
                        "item": {
                          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/item"
                        }
                      },
                      "required": ["id", "type", "item"]
                    }
                  ]
                }
              }
            },
            "required": ["key", "value"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "const": "bw-gm-scenes"
              },
              "value": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "$ref": "#/$defs/scene"
                }
              }
            },
            "required": ["key", "value"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "const": "bw-gm-tables"
              },
              "value": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "$ref": "#/$defs/table"
                }
              }
            },
            "required": ["key", "value"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "const": "bw-gm-friends"
              },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/id"
                  },
                  "die": {
                    "enum": [4, 6, 8, 10, 12]
                  },
                  "slots": {
                    "type": "array",
                    "maxItems": 1000,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/id"
                        },
                        "index": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 11
                        },
                        "name": {
                          "type": "string",
                          "maxLength": 512
                        },
                        "notes": {
                          "type": "string",
                          "maxLength": 65536
                        },
                        "sourceNpcId": {
                          "type": "string",
                          "maxLength": 128
                        }
                      },
                      "required": ["id", "index", "name"]
                    }
                  }
                },
                "required": ["id", "die", "slots"]
              }
            },
            "required": ["key", "value"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "const": "bw-rolllog2"
              },
              "value": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "$ref": "#/$defs/logEntry"
                }
              }
            },
            "required": ["key", "value"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "const": "bw-player-log"
              },
              "value": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "$ref": "#/$defs/logEntry"
                }
              }
            },
            "required": ["key", "value"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "const": "bw-gm-npcs"
              },
              "value": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "$ref": "#/$defs/npc"
                }
              }
            },
            "required": ["key", "value"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "const": "bw-gm-relics"
              },
              "value": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/item"
                }
              }
            },
            "required": ["key", "value"]
          }
        ]
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "mediaType": {
            "enum": ["image/png", "image/jpeg", "image/webp", "image/gif"]
          },
          "encoding": {
            "const": "base64"
          },
          "data": {
            "type": "string",
            "maxLength": 2796204,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["id", "mediaType", "encoding", "data", "byteLength", "sha256"]
      },
      "maxItems": 1000
    }
  },
  "required": ["format", "version", "id", "exportedAt", "characters", "gameData", "assets"],
  "$defs": {
    "npc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "desc": {
          "type": "string",
          "maxLength": 65536
        },
        "image": {
          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/image"
        },
        "icon": {
          "type": "string",
          "maxLength": 128
        },
        "armor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "wants": {
          "type": "string",
          "maxLength": 65536
        },
        "found": {
          "type": "string",
          "maxLength": 65536
        },
        "str": {
          "enum": [4, 6, 8, 10, 12]
        },
        "dex": {
          "enum": [4, 6, 8, 10, 12]
        },
        "wil": {
          "enum": [4, 6, 8, 10, 12]
        },
        "grit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attacks": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/item"
          }
        }
      },
      "required": ["id", "name", "notes", "str", "dex", "wil", "grit", "attacks"]
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "desc": {
          "type": "string",
          "maxLength": 65536
        },
        "image": {
          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/image"
        },
        "icon": {
          "type": "string",
          "maxLength": 128
        },
        "armor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "wants": {
          "type": "string",
          "maxLength": 65536
        },
        "found": {
          "type": "string",
          "maxLength": 65536
        },
        "str": {
          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/dieAttribute"
        },
        "dex": {
          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/dieAttribute"
        },
        "wil": {
          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/dieAttribute"
        },
        "grit": {
          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/attribute"
        },
        "status": {
          "type": "string",
          "maxLength": 512
        },
        "attacks": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/item"
          }
        }
      },
      "required": ["id", "name", "notes", "str", "dex", "wil", "grit", "status", "armor", "attacks"]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "desc": {
          "type": "string",
          "maxLength": 65536
        },
        "image": {
          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/image"
        },
        "icon": {
          "type": "string",
          "maxLength": 128
        },
        "gmnotes": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": ["id", "name"]
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "desc": {
          "type": "string",
          "maxLength": 65536
        },
        "image": {
          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/image"
        },
        "icon": {
          "type": "string",
          "maxLength": 128
        },
        "npcs": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/npc"
          }
        }
      },
      "required": ["id", "name", "desc", "npcs"]
    },
    "tableEntity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "item"
            },
            "data": {
              "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/item"
            }
          },
          "required": ["kind", "data"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "npc"
            },
            "data": {
              "$ref": "#/$defs/npc"
            }
          },
          "required": ["kind", "data"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "encounter"
            },
            "data": {
              "$ref": "#/$defs/encounter"
            }
          },
          "required": ["kind", "data"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "scene"
            },
            "data": {
              "$ref": "#/$defs/scene"
            }
          },
          "required": ["kind", "data"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "spell"
            },
            "data": {
              "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/spell"
            }
          },
          "required": ["kind", "data"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "ritual"
            },
            "data": {
              "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/ritual"
            }
          },
          "required": ["kind", "data"]
        }
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "desc": {
          "type": "string",
          "maxLength": 65536
        },
        "image": {
          "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/image"
        },
        "icon": {
          "type": "string",
          "maxLength": 128
        },
        "formula": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "options": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "text"
                  },
                  "trigger": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      }
                    ]
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 65536
                  }
                },
                "required": ["type", "trigger", "value"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "entity"
                  },
                  "trigger": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      }
                    ]
                  },
                  "value": {
                    "$ref": "#/$defs/tableEntity"
                  }
                },
                "required": ["type", "trigger", "value"]
              }
            ]
          }
        }
      },
      "required": ["id", "name", "formula", "options"]
    },
    "embed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "maxLength": 65536
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 512
            },
            "icon_url": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^https?://[^\\s/@?#]+(?:[/?#][^\\s]*)?$",
              "format": "uri"
            }
          },
          "required": ["name"]
        },
        "footer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 512
            },
            "icon_url": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^https?://[^\\s/@?#]+(?:[/?#][^\\s]*)?$",
              "format": "uri"
            }
          },
          "required": ["text"]
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^https?://[^\\s/@?#]+(?:[/?#][^\\s]*)?$",
              "format": "uri"
            }
          },
          "required": ["url"]
        },
        "fields": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 512
              },
              "value": {
                "type": "string",
                "maxLength": 65536
              },
              "inline": {
                "type": "boolean"
              }
            },
            "required": ["name", "value"]
          }
        },
        "color": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777215
        }
      },
      "required": ["fields"]
    },
    "logEntry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/id"
            },
            "name": {
              "type": "string",
              "maxLength": 512
            },
            "time": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "type": {
              "const": "roll"
            },
            "roll": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "dice": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "enum": [4, 6, 8, 10, 12]
                  }
                },
                "result": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "label": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              "required": ["dice", "result"]
            }
          },
          "required": ["id", "name", "type", "roll"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "https://brighterworlds.app/schemas/sheet-v1.schema.json#/$defs/id"
            },
            "name": {
              "type": "string",
              "maxLength": 512
            },
            "time": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "type": {
              "const": "embed"
            },
            "embed": {
              "$ref": "#/$defs/embed"
            }
          },
          "required": ["id", "name", "type", "embed"]
        }
      ]
    }
  }
}
